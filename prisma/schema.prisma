generator client {
  provider = "prisma-client"
  output   = "../src/prisma/generated"
}

datasource db {
  provider = "postgresql"
}

//
// ──────────────────────────────────────────────────────────
// ENUMS
// ──────────────────────────────────────────────────────────
//
enum Channel {
  IN_APP
  PUSH
  EMAIL
  SMS
  WHATSAPP

  @@map("channel")
}

enum ContentFormat {
  TEXT
  HTML
  MARKDOWN

  @@map("content_format")
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@map("priority")
}

enum NotificationStatus {
  PENDING
  PROCESSING
  SENT
  DELIVERED
  FAILED
  CANCELLED
  EXPIRED
  ARCHIVED

  @@map("notification_status")
}

//
// ──────────────────────────────────────────────────────────
// TEMPLATE
// ──────────────────────────────────────────────────────────
//
model Template {
  id       String  @id @default(uuid()) @map("id")
  tenantId String? @map("tenant_id") @db.Uuid

  key     String  @map("key")
  channel Channel

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tags          String[]          @default([]) @map("tags")
  versions      TemplateVersion[]
  notifications Notification[]

  @@unique([tenantId, key, channel])
  @@map("template")
}

model TemplateVersion {
  id         String   @id @default(uuid())
  templateId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  locale  String @default("de-DE")
  version Int

  subject String?
  body    String
  format  ContentFormat

  variables Json @default("{}")

  isActive Boolean @default(true)

  createdAt DateTime @default(now())

  @@unique([templateId, locale, version])
  @@index([templateId, locale, isActive])
  @@map("template_version")
}

//
// ──────────────────────────────────────────────────────────
// NOTIFICATION INSTANCE
// ──────────────────────────────────────────────────────────
//
model Notification {
  id String @id @default(uuid()) @map("id")

  tenantId String? @db.Uuid

  // ── Recipient ───────────────────────────────────────────
  recipientUsername String  @map("recipient_username")
  recipientId       String? @map("recipient_id") @db.Uuid
  recipientAddress  String? @map("recipient_address")

  // ── Template & Rendering ─────────────────────────────────
  templateId      String?   @map("template_id")
  template        Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  templateVersion Int?

  variables     Json           @default("{}") @map("variables")
  metadata      Json           @default("{}")
  title         String?
  body          String?
  contentFormat ContentFormat? @map("content_format")

  channel  Channel  @map("channel")
  priority Priority @default(NORMAL) @map("priority")
  category String?  @map("category")

  // ── Lifecycle ────────────────────────────────────────────
  status NotificationStatus @default(PENDING) @map("status")

  readAt      DateTime?
  deliveredAt DateTime?
  expiresAt   DateTime?
  archivedAt  DateTime?
  purgedAt    DateTime?

  /// Marks notifications containing secrets
  sensitive Boolean @default(false) @map("sensitive")

  // ── Audit ────────────────────────────────────────────────
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by") @db.Uuid

  provider      String?
  providerRef   String?
  failureReason String? @map("failure_reason")

  @@index([status, createdAt])
  @@index([tenantId, status])
  @@index([recipientUsername, createdAt])
  @@index([expiresAt])
  @@map("notification")
}

////////////////////////////////
// C O N V E R S A T I O N /////
////////////////////////////////

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
  QUEUED
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

////////////////////////////////
// S U P P O R T   C H A T ///
////////////////////////////////

enum ConversationChannel {
  WHATSAPP
  EMAIL
  WEBCHAT
  SMS

  @@map("conversation_channel")
}

enum ConversationStatus {
  OPEN
  ASSIGNED
  PENDING
  RESOLVED
  CLOSED

  @@map("conversation_status")
}

enum ConversationPriority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@map("conversation_priority")
}

model ConversationMapping {
  id String @id @default(uuid())

  tenantId               String?               @map("tenant_id") @db.Uuid
  channel                ConversationChannel   @map("channel")
  externalId             String                @map("external_id") // phone number (with @c.us), email address, etc.
  eventId                String?               @map("event_id")
  conversationId         String?               @map("conversation_id")
  conversation           SupportConversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  internalConversationId String?               @map("internal_conversation_id")
  internalConversation   InternalConversation? @relation(fields: [internalConversationId], references: [id], onDelete: SetNull)
  provider               String                @default("LEGACY") @map("provider")

  mappingType String @default("AUTO") @map("mapping_type") // AUTO, MANUAL, FALLBACK
  metadata    Json?  @default("{}") @map("metadata")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, channel, externalId, eventId], name: "uq_conversation_mapping")
  @@index([channel, externalId])
  @@index([conversationId])
  @@index([internalConversationId])
  @@index([eventId])
  @@index([tenantId, eventId])
  @@map("conversation_mapping")
}

model SupportConversation {
  id String @id @default(uuid())

  tenantId     String? @map("tenant_id") @db.Uuid
  eventId      String  @map("event_id")
  invitationId String? @map("invitation_id")

  guestUserId  String? @map("guest_user_id") @db.Uuid
  guestName    String  @map("guest_name")
  guestContact String? @map("guest_contact")

  subject  String?
  status   ConversationStatus   @default(OPEN) @map("status")
  priority ConversationPriority @default(NORMAL) @map("priority")

  assignedTo     String? @map("assigned_to")
  assignedToUser String? @map("assigned_to_user")

  channel ConversationChannel @map("channel")

  lastMessageAt      DateTime? @map("last_message_at")
  lastMessagePreview String?   @map("last_message_preview")

  // Email threading
  emailMessageId  String? @map("email_message_id")
  emailInReplyTo  String? @map("email_in_reply_to")
  emailReferences String? @map("email_references")

  // Tags & metadata
  tags     String[] @default([]) @map("tags")
  metadata Json?    @default("{}") @map("metadata")

  // Unread tracking
  unreadCount      Int @default(0) @map("unread_count")
  guestUnreadCount Int @default(0) @map("guest_unread_count")

  // SLA / escalation
  slaDeadline DateTime? @map("sla_deadline")
  escalatedAt DateTime? @map("escalated_at")
  escalatedTo String?   @map("escalated_to")

  // Internal
  internalNote String? @map("internal_note")

  // Soft delete
  deletedAt DateTime? @map("deleted_at")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  closedAt  DateTime? @map("closed_at")

  mappings    ConversationMapping[]
  messages    SupportMessage[]
  assignments SupportAssignmentHistory[]

  @@index([eventId])
  @@index([guestUserId])
  @@index([assignedTo])
  @@index([status])
  @@index([eventId, status])
  @@index([tenantId, eventId, status])
  @@index([assignedTo, status])
  @@index([createdAt])
  @@index([emailMessageId])
  @@index([deletedAt])
  @@map("support_conversation")
}

model SupportMessage {
  id String @id @default(uuid())

  conversationId String
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  direction MessageDirection    @map("direction")
  channel   ConversationChannel @map("channel")

  fromUserId String? @map("from_user_id") @db.Uuid
  fromGuest  Boolean @default(false) @map("from_guest")

  body     String?
  mediaUrl String? @map("media_url")
  mimeType String? @map("mime_type")

  status     MessageStatus @default(SENT) @map("status")
  externalId String?       @map("external_id")
  provider   String?       @map("provider")
  error      String?

  emailMessageId  String? @map("email_message_id")
  emailInReplyTo  String? @map("email_in_reply_to")
  emailReferences String? @map("email_references")

  // Delivery tracking
  deliveredAt DateTime? @map("delivered_at")
  readAt      DateTime? @map("read_at")

  // Edits
  editedAt  DateTime? @map("edited_at")
  editCount Int       @default(0) @map("edit_count")

  // Soft delete
  deletedAt DateTime? @map("deleted_at")

  createdAt DateTime @default(now()) @map("created_at")

  deliveries MessageDelivery[]

  @@unique([conversationId, externalId], name: "uq_support_message_external")
  @@unique([provider, externalId], name: "uq_support_message_provider_external")
  @@index([conversationId])
  @@index([createdAt])
  @@index([deletedAt])
  @@map("support_message")
}

model MessageDelivery {
  id String @id @default(uuid())

  messageId String
  message   SupportMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  channel     ConversationChannel @map("channel")
  status      MessageStatus       @default(SENT) @map("status")
  attempt     Int                 @default(0) @map("attempt")
  deliveredAt DateTime?           @map("delivered_at")
  readAt      DateTime?           @map("read_at")
  error       String?
  providerRef String?             @map("provider_ref")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([messageId])
  @@index([status])
  @@index([channel, status])
  @@map("message_delivery")
}

model SupportAssignmentHistory {
  id String @id @default(uuid())

  conversationId String
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  assignedTo String @map("assigned_to")
  assignedBy String @map("assigned_by") @db.Uuid

  assignedAt DateTime @default(now()) @map("assigned_at")

  @@index([conversationId])
  @@map("support_assignment_history")
}

model SupportQuickReply {
  id String @id @default(uuid())

  key     String               @unique
  body    String
  channel ConversationChannel?

  tags String[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("support_quick_reply")
}

////////////////////////////////
// I N T E R N A L   C H A T //
////////////////////////////////

enum InternalConversationType {
  BROADCAST
  DIRECT
  ROLE_CHANNEL

  @@map("internal_conversation_type")
}

enum InternalMessagePriority {
  LOW
  NORMAL
  HIGH
  URGENT

  @@map("internal_message_priority")
}

model InternalConversation {
  id String @id @default(uuid())

  tenantId String?             @map("tenant_id") @db.Uuid
  eventId  String              @map("event_id")
  channel  ConversationChannel @default(WEBCHAT) @map("channel")

  title           String                   @map("title")
  description     String?                  @map("description")
  type            InternalConversationType @default(DIRECT) @map("type")
  roleId          String?                  @map("role_id") // For ROLE_CHANNEL type
  participantHash String?                  @map("participant_hash")

  createdBy String  @map("created_by")
  isActive  Boolean @default(true) @map("is_active")

  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  archivedAt DateTime? @map("archived_at")

  messages     InternalMessage[]
  participants InternalParticipant[]
  mappings     ConversationMapping[]

  @@unique([tenantId, eventId, channel, type, participantHash], name: "uq_internal_conversation")
  @@index([eventId])
  @@index([type])
  @@index([eventId, type])
  @@index([tenantId, eventId, type])
  @@index([roleId])
  @@map("internal_conversation")
}

model InternalMessage {
  id String @id @default(uuid())

  conversationId String
  conversation   InternalConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId String @map("sender_id") @db.Uuid

  direction  MessageDirection    @default(OUTBOUND) @map("direction")
  channel    ConversationChannel @default(WEBCHAT) @map("channel")
  provider   String?             @map("provider")
  externalId String?             @map("external_id")

  body     String                  @map("body")
  priority InternalMessagePriority @default(NORMAL) @map("priority")

  createdAt DateTime  @default(now()) @map("created_at")
  editedAt  DateTime? @map("edited_at")

  emailMessageId  String? @map("email_message_id")
  emailInReplyTo  String? @map("email_in_reply_to")
  emailReferences String? @map("email_references")

  @@unique([provider, externalId], name: "uq_internal_message_provider_external")
  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@map("internal_message")
}

model InternalParticipant {
  id String @id @default(uuid())

  conversationId String
  conversation   InternalConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  userId String @map("user_id") @db.Uuid

  lastReadAt DateTime? @map("last_read_at")
  joinedAt   DateTime  @default(now()) @map("joined_at")
  leftAt     DateTime? @map("left_at")

  @@unique([conversationId, userId], name: "uq_internal_participant")
  @@index([userId])
  @@map("internal_participant")
}

model EventAccessProjection {
  id          String    @id @default(uuid()) @map("id")
  eventId     String    @map("event_id")
  userId      String    @map("user_id")
  permissions String[]  @default([]) @map("permissions")
  roles       Json?     @map("roles")
  occurredAt  DateTime? @map("occurred_at")
  updatedAt   DateTime? @updatedAt @map("updated_at")

  @@unique([eventId, userId], name: "uq_event_access_projection")
  @@index([eventId], name: "idx_event_access_projection_event")
  @@map("event_access_projection")
}

model UserContactProjection {
  userId       String   @id @map("user_id") @db.Uuid
  email        String?  @map("email")
  primaryPhone String?  @map("primary_phone")
  displayName  String?  @map("display_name")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@index([primaryPhone])
  @@map("user_contact_projection")
}

////////////////////////////////
// O U T B O X ////////////////
////////////////////////////////

enum OutboxStatus {
  PENDING
  PUBLISHED
  FAILED

  @@map("outbox_status")
}

model OutboxMessage {
  id String @id @default(uuid())

  topic   String  @map("topic")
  payload Json    @map("payload")
  key     String? @map("key")
  headers Json?   @default("{}") @map("headers")

  status         OutboxStatus @default(PENDING) @map("status")
  error          String?
  attempt        Int          @default(0) @map("attempt")
  maxRetry       Int          @default(5) @map("max_retry")
  nextAttemptAt  DateTime     @default(now()) @map("next_attempt_at")
  lockedAt       DateTime?    @map("locked_at")
  lockedBy       String?      @map("locked_by")
  deadLetteredAt DateTime?    @map("dead_lettered_at")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  publishedAt DateTime? @map("published_at")

  @@index([status, nextAttemptAt, createdAt])
  @@index([status, attempt])
  @@map("outbox_message")
}
