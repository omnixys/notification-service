NODE_ENV=development
DEFAULT_TENANT_ID=
SERVICE=notification-service
PORT=4000
SCHEMA_TARGET=tmp

# EMAIL sender config
FROM_NO_REPLY=Omnixys <no-reply@omnixys.com>
FROM_SUPPORT=Omnixys Support <support@omnixys.com>
FROM_SECURITY=Omnixys Security <security@omnixys.com>
# Stable UUIDv7 system sender identity sent as the gateway `senderId` contract field
FROM_SENDER_ID=

DATABASE_URL=postgresql://notification:notification@localhost:5432/notification
VALKEY_URL=valkey://localhost:6380
VALKEY_PASSWORD=replace-me
KAFKA_BROKER=localhost:9092

KC_URL=http://localhost:18080/auth
KC_REALM=omnixys
KC_CLIENT_ID=nexys
KC_CLIENT_SECRET=replace-me

ENCRYPTION_KEY=replace-with-32-byte-key
PC_JWE_KEY=replace-with-32-byte-key
COOKIE_SECRET=replace-with-at-least-32-random-bytes

APP_BASE_URL=http://localhost:3000
CHECKPOINT_APP_BASE_URL=http://localhost:3000
VERIFY_PATH=/verify
VERIFY_GUEST_PATH=/verify-guest
MAGIC_PATH=/magic
CHECKPOINT_MAGIC_PATH=/magic
RESET_PATH=/reset

TEMPO_URI=http://localhost:4318/v1/traces
KEYCLOAK_HEALTH_URL=
TEMPO_HEALTH_URL=
PROMETHEUS_HEALTH_URL=
LOG_LEVEL=info
LOG_PRETTY=true
GATEWAY_BASE_URL=http://localhost:8002
GATEWAY_API_KEY=replace-with-internal-api-key
